// --- TYPES ---
interface TrainData {
  id: string;
  number: string;
  name: string;
  time: string; // HH:mm format
  direction: string;
  days: number[]; // 0 = Sunday, 1 = Monday, etc.
  isValid: boolean;
}

interface TrainEvent {
  train: TrainData;
  startTs: number; // Unix timestamp for scheduled arrival/departure
  endTs: number;   // Unix timestamp for predicted reopening (+20 mins)
  formattedStart: string;
}

interface MergedInterval {
  start: number;
  end: number;
  causes: TrainEvent[];
}

interface PredictionState {
  status: 'OPEN' | 'CLOSED' | 'UNAVAILABLE';
  currentInterval: MergedInterval | null;
  nextInterval: MergedInterval | null;
  upcomingEvents: TrainEvent[];
}

