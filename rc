const PREDICTION_WINDOW_MS = 20 * 60 * 1000; // 20 minutes in milliseconds

// --- TIME AND PURE PREDICTION UTILITIES ---

/** Gets exact IST components from any UTC timestamp, bypassing local browser timezones. */
const getISTParts = (timestamp: number) => {
  const formatter = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Kolkata',
    year: 'numeric', month: 'numeric', day: 'numeric',
    hour: 'numeric', minute: 'numeric', second: 'numeric',
    hourCycle: 'h23'
  });
  
  const parts = formatter.formatToParts(new Date(timestamp));
  const get = (type: string) => parseInt(parts.find(p => p.type === type)?.value || '0', 10);
  
  return {
    year: get('year'),
    month: get('month') - 1, // JS months are 0-indexed
    day: get('day'),
    hour: get('hour'),
    minute: get('minute'),
    second: get('second')
  };
};

/** Creates a precise Unix timestamp from IST date components. (IST is UTC+5:30) */
const createISTTimestamp = (year: number, month: number, day: number, hour: number, minute: number): number => {
  const utcTs = Date.UTC(year, month, day, hour, minute);
  return utcTs - (5.5 * 60 * 60 * 1000); 
};

/** Formats a timestamp into an IST time string */
const formatTimeInIndia = (timestamp: number, includeSeconds = false): string => {
  return new Intl.DateTimeFormat('en-IN', {
    timeZone: 'Asia/Kolkata',
    hour: '2-digit', minute: '2-digit', second: includeSeconds ? '2-digit' : undefined,
    hour12: true
  }).format(new Date(timestamp));
};

/** Formats a timestamp into an IST date string including the weekday */
const formatDateInIndia = (timestamp: number): string => {
  return new Intl.DateTimeFormat('en-IN', {
    timeZone: 'Asia/Kolkata',
    weekday: 'long',
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  }).format(new Date(timestamp));
};

/** Formats milliseconds into a readable countdown */
const formatCountdown = (ms: number): string => {
  if (ms < 0) return '00:00';
  const totalSeconds = Math.floor(ms / 1000);
  const h = Math.floor(totalSeconds / 3600);
  const m = Math.floor((totalSeconds % 3600) / 60);
  const s = totalSeconds % 60;
  
  if (h > 0) return `${h}h ${m.toString().padStart(2, '0')}m`;
  return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
};

/** 
 * Generates actual scheduled events (timestamps) by expanding the timetable over 4 days.
 * This handles midnight crossovers and specific running days cleanly.
 */
const getApplicableTrainEvents = (baseTimeMs: number, schedule: TrainData[]): TrainEvent[] => {
  const currentIST = getISTParts(baseTimeMs);
  const events: TrainEvent[] = [];
  
  // Look from Yesterday to DayAfterTomorrow to ensure we catch all overlapping windows
  for (let offset = -1; offset <= 2; offset++) {
    // UTC date manipulation avoids DST / local timezone glitches when jumping days
    const dateObj = new Date(Date.UTC(currentIST.year, currentIST.month, currentIST.day + offset));
    const y = dateObj.getUTCFullYear();
    const m = dateObj.getUTCMonth();
    const d = dateObj.getUTCDate();
    const dayOfWeek = dateObj.getUTCDay();

    schedule.filter(t => t.isValid).forEach(train => {
      if (train.days.includes(dayOfWeek)) {
        const [hh, mm] = train.time.split(':').map(Number);
        const startTs = createISTTimestamp(y, m, d, hh, mm);
        
        events.push({
          train,
          startTs,
          endTs: startTs + PREDICTION_WINDOW_MS,
          formattedStart: formatTimeInIndia(startTs)
        });
      }
    });
  }
  
  // Sort chronologically
  return events.sort((a, b) => a.startTs - b.startTs);
};

/** Merges overlapping intervals to prevent the gate opening incorrectly between two close trains */
const getActiveClosureIntervals = (events: TrainEvent[]): MergedInterval[] => {
  if (!events.length) return [];
  
  const merged: MergedInterval[] = [];
  let currentBlock: MergedInterval = {
    start: events[0].startTs,
    end: events[0].endTs,
    causes: [events[0]]
  };

  for (let i = 1; i < events.length; i++) {
    const ev = events[i];
    if (ev.startTs <= currentBlock.end) {
      // Overlap detected! Extend the current block.
      currentBlock.end = Math.max(currentBlock.end, ev.endTs);
      currentBlock.causes.push(ev);
    } else {
      merged.push(currentBlock);
      currentBlock = {
        start: ev.startTs,
        end: ev.endTs,
        causes: [ev]
      };
    }
  }
  merged.push(currentBlock);
  return merged;
};

/** Evaluates the current state against all intervals */
const getPredictedGateStatus = (intervals: MergedInterval[], events: TrainEvent[], nowMs: number): PredictionState => {
  if (!intervals.length) {
    return { status: 'UNAVAILABLE', currentInterval: null, nextInterval: null, upcomingEvents: [] };
  }

  const active = intervals.find(i => i.start <= nowMs && i.end > nowMs);
  const futureIntervals = intervals.filter(i => i.start > nowMs);
  const next = futureIntervals.length > 0 ? futureIntervals[0] : null;
  const upcomingEvents = events.filter(e => e.startTs > nowMs || (e.startTs <= nowMs && e.endTs > nowMs)).slice(0, 7);

  if (active) {
    return { status: 'CLOSED', currentInterval: active, nextInterval: next, upcomingEvents };
  }
  
  return { status: 'OPEN', currentInterval: null, nextInterval: next, upcomingEvents };
};

// --- AUTOMATED TESTS ---
const runAutomatedTests = () => {
  const results: { name: string; passed: boolean; message: string }[] = [];
  const testSchedule = [...TRAIN_SCHEDULES];
  
  const assert = (name: string, condition: boolean, msg: string) => {
    results.push({ name, passed: condition, message: msg });
  };

  try {
    // 1. Current time is before the next train (07:00 AM for 07:05 train)
    const t1 = createISTTimestamp(2026, 9, 14, 7, 0); // 07:00
    const ev1 = getApplicableTrainEvents(t1, testSchedule);
    const int1 = getActiveClosureIntervals(ev1);
    const p1 = getPredictedGateStatus(int1, ev1, t1);
    assert("1. Time before next train", p1.status === 'OPEN' && p1.nextInterval?.causes[0].train.time === '07:05', `Expected OPEN, got ${p1.status}`);

    // 2. Exact start of closure (07:05 AM)
    const t2 = createISTTimestamp(2026, 9, 14, 7, 5); 
    const p2 = getPredictedGateStatus(int1, ev1, t2);
    assert("2. Exact closure start", p2.status === 'CLOSED', `Expected CLOSED, got ${p2.status}`);

    // 3. 10 minutes into closure (07:15 AM)
    const t3 = createISTTimestamp(2026, 9, 14, 7, 15);
    const p3 = getPredictedGateStatus(int1, ev1, t3);
    assert("3. Middle of closure", p3.status === 'CLOSED', `Expected CLOSED, got ${p3.status}`);

    // 4. Exactly 20 minutes after (07:25 AM) -> Should be OPEN (interval is [start, end) )
    const t4 = createISTTimestamp(2026, 9, 14, 7, 25);
    const p4 = getPredictedGateStatus(int1, ev1, t4);
    assert("4. End of closure window", p4.status === 'OPEN', `Expected OPEN, got ${p4.status}`);

    // 6. Overlapping intervals (10:40 and 10:45 trains)
    const tOver = createISTTimestamp(2026, 9, 14, 10, 50); // Inside overlap
    const pOver = getPredictedGateStatus(int1, ev1, tOver);
    assert("6. Overlapping schedules", pOver.status === 'CLOSED' && pOver.currentInterval?.causes.length === 2, `Expected CLOSED with 2 causes, got ${pOver.currentInterval?.causes.length}`);

    // 7. Midnight crossing (23:55 PM)
    const tMid = createISTTimestamp(2026, 9, 14, 23, 55); 
    const pMid = getPredictedGateStatus(int1, ev1, tMid);
    // 23:50 train ends at 00:10. Status should be closed.
    assert("7. Midnight crossing", pMid.status === 'CLOSED' && pMid.currentInterval?.causes[0].train.number === '16343', `Expected CLOSED by 16343, got ${pMid.status}`);

    // 10. Missing/Invalid data
    const hasInvalid = ev1.some(e => e.train.id === '12');
    assert("10. Exclude invalid schedules", !hasInvalid, "Invalid schedule (id 12) was incorrectly parsed into events");

  } catch (err: any) {
    assert("Test execution", false, `Fatal error during tests: ${err.message}`);
  }

  return results;
};


